{
  "name": "e-commerce",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n \"BACKEND,FRONTEND\" -c \"blue,magenta\" \"python -m uvicorn backend.main:app --app-dir .. --host 127.0.0.1 --port 8000 --reload --reload-dir ../backend\" \"node_modules\\.bin\\vite.cmd\"",
    "dev:frontend": "node_modules\\.bin\\vite.cmd",
    "dev:backend": "python -m uvicorn backend.main:app --app-dir .. --host 127.0.0.1 --port 8000 --reload --reload-dir ../backend",
    "backend": "python -m uvicorn backend.main:app --app-dir .. --host 127.0.0.1 --port 8000 --reload --reload-dir ../backend",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@cloudinary/react": "^1.14.4",
    "@cloudinary/url-gen": "^1.22.0",
    "@tailwindcss/vite": "^4.3.3",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "framer-motion": "^13.4.5",
    "lucide-react": "^1.69.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "oxlint": "^1.79.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
