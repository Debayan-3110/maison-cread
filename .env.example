# Neon Serverless Postgres Configuration
DATABASE_URL="postgresql://user:password@endpoint-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
NEON_DATABASE_URL="postgresql://user:password@endpoint-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
NEON_API_KEY="your_neon_api_key_here"

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
DATABASE_URL_UNPOOLED="postgresql://user:password@endpoint.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
NEON_BRANCH=production
NEON_BRANCH_ID=your_neon_branch_id
NEON_FUNCTION_HOST_SUFFIX=.compute.c-4.ap-southeast-1.aws.neon.tech
NEON_AUTH_BASE_URL=https://your-endpoint.neonauth.c-4.ap-southeast-1.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://your-endpoint.neonauth.c-4.ap-southeast-1.aws.neon.tech/neondb/auth/.well-known/jwks.json
NEON_REALTIME_URL=wss://your-endpoint.rt.c-4.ap-southeast-1.aws.neon.tech/
NEON_REALTIME_SECRET=your_neon_realtime_secret
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_ENDPOINT_URL_S3=https://your-branch.storage.c-4.ap-southeast-1.aws.neon.tech
AWS_REGION=ap-southeast-1

# CockroachDB Labs Storage Configuration
USER_ID="your_cockroach_user"
PASSWORD="your_cockroach_password"
COCKROACH_USER="your_cockroach_user"
COCKROACH_PASSWORD="your_cockroach_password"
COCKROACH_HOST="your-cluster.cockroachlabs.cloud"
COCKROACH_PORT="26257"
COCKROACH_DATABASE="defaultdb"
COCKROACH_DATABASE_URL="postgresql://user:password@your-cluster.cockroachlabs.cloud:26257/defaultdb?sslmode=verify-full"

# Cloudinary Image Storage & CDN Cache Configuration
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"
CLOUDINARY_URL="cloudinary://your_key:your_secret@your_cloud_name"

# SMTP Mail Delivery Protocol Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=security@shopcread.com
SMTP_FROM_NAME="Maison Cread Security"
SMTP_USE_TLS=true
SMTP_USE_SSL=false
